[Unit]
Description=foxChess — configuration depuis SSM vers /run/foxchess/.env
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
RuntimeDirectory=foxchess
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ExecStart=/usr/local/sbin/foxchess-env-fetch.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
